# 复制成 .env.local（不会提交）再填。这里只能放「公开」配置：VITE_ 开头的值会被打包进小程序，任何人都能看到。
# 密钥（service_role、AI Key、AppSecret、小程序上传密钥）不能写在这里，也不能用 VITE_ 开头，见 docs/C-集成指南.md。

# dev | prod
VITE_APP_ENV=dev

# Supabase 项目地址和 anon（publishable）key，由 A 建好项目后提供；留空时页面走单机模式
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 微信云开发环境 ID，由 A 提供
VITE_WX_CLOUD_ENV=
