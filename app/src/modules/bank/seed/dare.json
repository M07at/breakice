{
  "format": "pobingju-bank",
  "version": 1,
  "gameType": "dare",
  "name": "系统题库·大冒险",
  "description": "适合教室里做的大冒险，不涉及身体接触和隐私；都可以申请换一题",
  "items": [
    {"content":{"text":"用三个词介绍你右边的人。"},"tags":["破冰"],"difficulty":1},
    {"content":{"text":"模仿一种动物的叫声，让大家猜是什么。"},"tags":["表演"],"difficulty":1},
    {"content":{"text":"用家乡话说一句「很高兴认识大家」。"},"tags":["破冰"],"difficulty":1},
    {"content":{"text":"做一个你最拿手的鬼脸，保持 5 秒。"},"tags":["表演"],"difficulty":1},
    {"content":{"text":"认真夸一夸你左边的人。"},"tags":["破冰"],"difficulty":1},
    {"content":{"text":"站起来做一个自我介绍，结尾加一个动作。"},"tags":["破冰"],"difficulty":1},
    {"content":{"text":"唱一首歌的副歌部分。"},"tags":["表演"],"difficulty":1},
    {"content":{"text":"用表情和动作表演一个成语，让大家猜。"},"tags":["表演"],"difficulty":1},
    {"content":{"text":"不看名牌，说出在场三个人的名字。"},"tags":["破冰"],"difficulty":1},
    {"content":{"text":"用夸张的语气播报一条今天的天气预报。"},"tags":["表演"],"difficulty":1},
    {"content":{"text":"用机器人的声音说完你的下一句话。"},"tags":["表演"],"difficulty":1},
    {"content":{"text":"模仿一句经典的电影台词。"},"tags":["表演"],"difficulty":1},
    {"content":{"text":"用非惯用手写下自己的名字给大家看。"},"tags":["挑战"],"difficulty":1},
    {"content":{"text":"如果对方愿意，和右边的人击掌说「以后多关照」。"},"tags":["破冰"],"difficulty":1},
    {"content":{"text":"讲一个冷笑话。"},"tags":["表演"],"difficulty":1},
    {"content":{"text":"做 10 个深蹲。"},"tags":["挑战"],"difficulty":1},
    {"content":{"text":"用开心、生气、委屈三种语气说「你好」。"},"tags":["表演"],"difficulty":1},
    {"content":{"text":"表演一段 10 秒的即兴舞蹈。"},"tags":["表演"],"difficulty":1},
    {"content":{"text":"闭上眼睛，说出你对面的人今天穿了什么颜色的衣服。"},"tags":["挑战"],"difficulty":1},
    {"content":{"text":"用一个词形容今天的活动，并说说为什么。"},"tags":["破冰"],"difficulty":1},
    {"content":{"text":"摆一个超级英雄的姿势，保持 10 秒。"},"tags":["表演"],"difficulty":1},
    {"content":{"text":"用表情模仿三个 emoji，让大家猜。"},"tags":["表演"],"difficulty":1},
    {"content":{"text":"把自己的名字倒过来念一遍。"},"tags":["挑战"],"difficulty":1},
    {"content":{"text":"用 30 秒讲一件你最近遇到的趣事。"},"tags":["破冰"],"difficulty":1},
    {"content":{"text":"记住在场五个人的名字，然后一口气说出来。"},"tags":["破冰"],"difficulty":2},
    {"content":{"text":"用 rap 的方式做一个自我介绍。"},"tags":["表演"],"difficulty":2},
    {"content":{"text":"善意地模仿在场一个人的口头禅，让大家猜是谁。"},"tags":["表演"],"difficulty":2},
    {"content":{"text":"让左边的人给你出一个动作，你照着做（不能为难人）。"},"tags":["挑战"],"difficulty":2},
    {"content":{"text":"用播音腔朗读一段你喜欢的诗。"},"tags":["表演"],"difficulty":2},
    {"content":{"text":"给在场一个人起一个好听的外号，并解释原因。"},"tags":["破冰"],"difficulty":2},
    {"content":{"text":"用三个动作表演你的专业，让大家猜。"},"tags":["表演"],"difficulty":2},
    {"content":{"text":"30 秒内说出 10 种水果。"},"tags":["挑战"],"difficulty":2},
    {"content":{"text":"和右边的人一起编一句口号送给大家。"},"tags":["破冰"],"difficulty":2},
    {"content":{"text":"站起来，用最有感情的方式说一句「我爱学习」。"},"tags":["表演"],"difficulty":2},
    {"content":{"text":"摆一个你觉得最酷的拍照姿势。"},"tags":["表演"],"difficulty":2},
    {"content":{"text":"选一个人，说出你对他的第一印象（只说好的）。"},"tags":["破冰"],"difficulty":2},
    {"content":{"text":"用身体摆出一个字母，让大家猜。"},"tags":["表演"],"difficulty":2},
    {"content":{"text":"用嘴模仿一种乐器，演奏一小段。"},"tags":["表演"],"difficulty":2},
    {"content":{"text":"用 30 秒向大家推荐一样你最近很喜欢的东西。"},"tags":["破冰"],"difficulty":2},
    {"content":{"text":"和对面的人对视 10 秒，谁先笑谁输。"},"tags":["挑战"],"difficulty":2},
    {"content":{"text":"用三句话讲一个完整的故事。"},"tags":["表演"],"difficulty":2},
    {"content":{"text":"用身体动作把你的名字「写」出来。"},"tags":["表演"],"difficulty":2},
    {"content":{"text":"说出你今天认识的人的名字，越多越好。"},"tags":["破冰"],"difficulty":2},
    {"content":{"text":"准备一分钟，做一段即兴演讲：为什么大家应该加入我们。"},"tags":["表演"],"difficulty":3},
    {"content":{"text":"现场教大家一个你会的小技能。"},"tags":["破冰"],"difficulty":3},
    {"content":{"text":"邀请两个人和你一起表演一个 30 秒的小短剧。"},"tags":["表演"],"difficulty":3},
    {"content":{"text":"唱一首歌，但把歌词全部换成「啦」。"},"tags":["表演"],"difficulty":3},
    {"content":{"text":"用三种不同的语言或方言说「谢谢」。"},"tags":["挑战"],"difficulty":3},
    {"content":{"text":"学企鹅走路，绕场一圈。"},"tags":["表演"],"difficulty":3},
    {"content":{"text":"给今天的活动编一句四字口号。"},"tags":["破冰"],"difficulty":3},
    {"content":{"text":"选一首大家都会的歌，你起头，大家一起合唱一段。"},"tags":["表演"],"difficulty":3},
    {"content":{"text":"对十年后的自己说一句话，说给大家听。"},"tags":["破冰"],"difficulty":3}
  ]
}
