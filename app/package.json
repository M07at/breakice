{
  "name": "pobingju",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:mp-weixin": "uni -p mp-weixin",
    "dev:h5": "uni",
    "dev:players": "uni --host 0.0.0.0",
    "build:mp-weixin": "uni build -p mp-weixin",
    "build:h5": "uni build",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:size": "node ../scripts/check-mp-size.mjs dist/build/mp-weixin",
    "check:secrets": "node ../scripts/check-secrets.mjs . ../scripts ../supabase ../cloudfunctions",
    "verify": "node ../scripts/verify.mjs",
    "doctor": "node ../scripts/doctor.mjs",
    "test:ci": "vitest run --reporter=default --reporter=junit --outputFile=reports/tests.xml",
    "test:quality": "node --test ../scripts/quality-gates.test.mjs",
    "release:manifest": "node ../scripts/release-manifest.mjs"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5020620260917001",
    "@dcloudio/uni-components": "3.0.0-5020620260917001",
    "@dcloudio/uni-h5": "3.0.0-5020620260917001",
    "@dcloudio/uni-mp-weixin": "3.0.0-5020620260917001",
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@dcloudio/types": "3.4.31",
    "@dcloudio/uni-cli-shared": "3.0.0-5020620260917001",
    "@dcloudio/uni-stacktracey": "3.0.0-5020620260917001",
    "@dcloudio/vite-plugin-uni": "3.0.0-5020620260917001",
    "@vue/runtime-core": "^3.4.21",
    "typescript": "^5.9.3",
    "vite": "5.2.8",
    "vitest": "3.2.7",
    "vue-tsc": "^2.2.12"
  },
  "overrides": {
    "express": "4.22.3",
    "qs": "6.16.1",
    "ws": "8.22.0",
    "source-map-js": "1.2.2",
    "@babel/core": "7.29.7",
    "postcss": "8.5.30",
    "postcss-selector-parser": "7.1.6",
    "jpeg-js": "0.4.4",
    "phin": "3.7.1",
    "adm-zip": "0.6.1",
    "@intlify/core-base": "9.14.5",
    "@intlify/message-compiler": "9.14.5",
    "@intlify/shared": "9.14.5",
    "@intlify/vue-devtools": "9.14.5",
    "@intlify/message-resolver": "9.1.11",
    "tinypool": "2.1.2"
  },
  "engines": {
    "node": ">=22"
  }
