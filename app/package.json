{
  "name": "break-ice-hall-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:h5": "uni -p h5",
    "dev:mp-weixin": "uni -p mp-weixin",
    "dev:players": "uni -p h5 --host 0.0.0.0",
    "build:h5": "uni build -p h5",
    "build:mp-weixin": "uni build -p mp-weixin",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run --reporter=default --reporter=junit --outputFile=reports/tests.xml",
    "test:quality": "node --test ../scripts/quality-gates.test.mjs",
    "check:size": "node ../scripts/check-mp-size.mjs dist/build/mp-weixin",
    "check:secrets": "node ../scripts/check-secrets.mjs . ../scripts",
    "check:backend": "node ../scripts/check-supabase.mjs",
    "check:uc": "node ../scripts/check-uc-command.mjs",
    "check:artwork": "node ../scripts/check-artwork.mjs",
    "check:truth": "node ../scripts/check-truth.mjs",
    "check:realtime": "node ../scripts/probe-realtime.mjs",
    "check:drawroom": "node ../scripts/check-draw-room.mjs",
    "check:qrcode": "node ../scripts/check-qrcode.mjs",
    "check:all": "node ../scripts/check-all.mjs",
    "check:security": "node ../scripts/check-security.mjs",
    "verify": "node ../scripts/verify.mjs",
    "doctor": "node ../scripts/doctor.mjs",
    "release:manifest": "node ../scripts/release-manifest.mjs"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5030320261023001",
    "@dcloudio/uni-components": "3.0.0-5030320261023001",
    "@dcloudio/uni-h5": "3.0.0-5030320261023001",
    "@dcloudio/uni-mp-weixin": "3.0.0-5030320261023001",
    "pinia": "2.1.7",
    "qrcode-generator": "^2.0.4",
    "vue": "3.4.21"
  },
  "devDependencies": {
    "@dcloudio/types": "3.4.31",
    "@dcloudio/vite-plugin-uni": "3.0.0-5030320261023001",
    "@types/node": "^22.13.4",
    "sass": "^1.85.1",
    "typescript": "^5.7.3",
    "vite": "5.2.8",
    "vitest": "3.2.7",
    "vue-tsc": "^2.2.0"
  },
  "overrides": {
    "express": "4.22.3",
    "qs": "6.16.1",
    "ws": "8.22.0",
    "source-map-js": "1.2.2",
    "@babel/core": "7.29.7",
    "postcss": "8.5.30",
    "postcss-selector-parser": "7.1.6",
    "jpeg-js": "0.4.4",
    "phin": "3.7.1",
    "adm-zip": "0.6.1",
    "@intlify/core-base": "9.14.5",
    "@intlify/message-compiler": "9.14.5",
    "@intlify/shared": "9.14.5",
    "@intlify/vue-devtools": "9.14.5",
    "@intlify/message-resolver": "9.1.11",
    "tinypool": "2.1.2"
  },
  "engines": {
    "node": ">=22"
  }
}
