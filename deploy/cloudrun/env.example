# 云托管环境变量模板（复制到控制台「环境变量」里填）
#
# 生成 JWT_SECRET 与两个 key 的方法见文末。

# ---- 必填 ----
JWT_SECRET=请替换为至少32位的随机串
POSTGRES_DB=breakice
POSTGRES_PASSWORD=请替换为强密码

# ---- 客户端会用到（填进小程序 .env.local）----
# ANON_KEY 与 SERVICE_ROLE_KEY 由 JWT_SECRET 签出，见文末脚本
# VITE_SUPABASE_URL       = https://<云托管默认域名>   （验证阶段直连用）
# VITE_SUPABASE_ANON_KEY  = <ANON_KEY>

# ---- 可选 ----
# STORAGE_DIR=/var/lib/storage
# AI_API_URL=（DeepSeek 接口地址）
# AI_API_KEY=（DeepSeek 密钥，建议用云托管密钥管理而不是环境变量明文）

# ============ 生成 ANON_KEY / SERVICE_ROLE_KEY ============
# 在本地任意装了 Node 的机器上执行：
#
# node -e "
# const c=require('crypto');
# const secret=process.env.JWT_SECRET;
# const b64=(o)=>Buffer.from(JSON.stringify(o)).toString('base64url');
# const sign=(p)=>c.createHmac('sha256',secret).update(p).digest('base64url');
# const mk=(role)=>{const h=b64({alg:'HS256',typ:'JWT'});
#   const p=b64({role,iss:'supabase',iat:1700000000,exp:2000000000});
#   return h+'.'+p+'.'+sign(h+'.'+p);};
# console.log('ANON_KEY='+mk('anon'));
# console.log('SERVICE_ROLE_KEY='+mk('service_role'));
# "
#
# 注意：exp 不能设太近，否则客户端会频繁失效。
